{
  "name": "nuxt-api-contract",
  "version": "1.2.0",
  "description": "Type-safe API contracts between Nitro server routes and the Nuxt client.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "modeusweb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modeusweb/nuxt-api-contract.git"
  },
  "bugs": {
    "url": "https://github.com/modeusweb/nuxt-api-contract/issues"
  },
  "homepage": "https://github.com/modeusweb/nuxt-api-contract#readme",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nitro",
    "api",
    "contract",
    "zod",
    "type-safe",
    "openapi"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./shared": {
      "types": "./dist/shared.d.mts",
      "import": "./dist/shared.mjs"
    },
    "./composables": {
      "types": "./dist/composables.d.mts",
      "import": "./dist/composables.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.mts",
      "import": "./dist/openapi.mjs"
    },
    "./clientgen": {
      "types": "./dist/clientgen.d.mts",
      "import": "./dist/clientgen.mjs"
    },
    "./mock": {
      "types": "./dist/mock.d.mts",
      "import": "./dist/mock.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nuxt-api-contract": "dist/cli.mjs"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev:prepare": "unbuild --stub",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:type": "vitest run --typecheck.enabled test/type",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test:unit && npm run test:type && npm run build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.2",
    "eslint": "^10.11.0",
    "nuxt": "^4.5.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
